{
  "name": "appgeniex",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently --continue-on-error \"npm:dev:backend\" \"npm:dev:frontend\" \"npm:dev:ml\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:ml": "npm --prefix ml-service run dev",
    "lint": "npm --prefix frontend run lint && npm --prefix backend run lint",
    "format": "npm --prefix frontend run format && npm --prefix backend run format && npm --prefix ml-service run format",
    "test": "npm --prefix ml-service run test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
